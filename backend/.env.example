APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

DATABASE_URL=postgres://tern:tern@localhost:5433/tern?sslmode=disable
REDIS_URL=redis://localhost:6380/0

SHUTDOWN_TIMEOUT=15s

# Static token for operator-only /admin routes. Generate one with: openssl rand -hex 24
ADMIN_TOKEN=dev-admin-token-change-me-0123456789

# Encrypts endpoint signing secrets at rest (AES-256-GCM). Required. Generate one with:
#   openssl rand -base64 32
# Keep it out of git and back it up: without it, stored signing secrets cannot be read.
SECRETS_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Dev only: allow http:// and localhost/private webhook URLs (disables SSRF protection).
ALLOW_LOCAL_ENDPOINTS=true

# Delivery worker: parallel deliveries per worker process, and the timeout of one HTTP request.
WORKER_CONCURRENCY=10
DELIVERY_TIMEOUT=10s

# Reliability. RETRY_SCHEDULE is the delay after each failed attempt (a delivery gets one more
# attempt than there are delays; "none" disables retries). AUTO_DISABLE_AFTER failed attempts in a
# row disable an endpoint. RECONCILE_INTERVAL is how often lost queue jobs are looked for.
RETRY_SCHEDULE=5s,5m,30m,2h,5h,10h,10h
AUTO_DISABLE_AFTER=20
RECONCILE_INTERVAL=5m

# Rate limits. Each tenant may send this many events per second (bursts of twice that are
# allowed), and each endpoint receives at most this many deliveries per second. 0 = unlimited.
RATE_LIMIT_EVENTS_PER_SECOND=100
RATE_LIMIT_ENDPOINT_DELIVERIES_PER_SECOND=25

# Retention. Events older than this many days are deleted, together with their deliveries and
# attempts. 0 keeps everything.
RETENTION_DAYS=30

# Where the worker serves Prometheus metrics (not authenticated: keep it on an internal network).
# Set it to an empty value to switch the listener off. The API serves /metrics on its own port,
# protected by ADMIN_TOKEN.
WORKER_METRICS_ADDR=:9102
